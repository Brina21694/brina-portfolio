# Copier ce fichier en .env.local pour changer la configuration.

# Adresse du backend vue par le NAVIGATEUR. Vide = on appelle /api sur le même domaine
# (le proxy de Vite redirige en dev).
VITE_API_URL=

# Cible du proxy Vite en développement (backend FastAPI de l'équipe).
VITE_API_PROXY=http://localhost:8000

# true = pas de backend : le site utilise des données d'exemple locales.
VITE_USE_MOCK=false
